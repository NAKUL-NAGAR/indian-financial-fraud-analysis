      <aliases enabled='yes' />
      <column caption='Account Type' datatype='string' name='[Account_Type]' role='dimension' type='nominal' />
      <column caption='Annual Income' datatype='integer' name='[Annual_Income]' role='measure' type='quantitative' />
      <column caption='Total Transactions' datatype='integer' name='[Calculation_1868398538018816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Transaction_ID])' />
      </column>
      <column caption='Total Amoount' datatype='real' name='[Calculation_1868398547296257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Transaction_Amount])' />
      </column>
      <column caption='Fraud Transactions' datatype='integer' name='[Calculation_1868398548295682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Fraud_Flag] = 1 THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_1868398558138372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fraud_Flag])/([Calculation_1868398538018816])' />
      </column>
      <column caption='Successful Transaction' datatype='real' name='[Calculation_1868398561390598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Successful_Flag] = 1&#13;&#10;then [Transaction_Amount]&#13;&#10;END' />
      </column>
      <column caption='International Transaction' datatype='integer' name='[Calculation_1868398567116808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Is_International] = 1 THEN 1 END' />
      </column>
      <column caption='Card ID' datatype='string' name='[Card_ID]' role='dimension' type='nominal' />
      <column caption='Card Mode' datatype='string' name='[Card_Mode]' role='dimension' type='nominal' />
      <column caption='Card Mode Card' datatype='string' name='[Card_Mode_Card]' role='dimension' type='nominal' />
      <column caption='Card Network' datatype='string' name='[Card_Network]' role='dimension' type='nominal' />
      <column caption='Card Network Card' datatype='string' name='[Card_Network_Card]' role='dimension' type='nominal' />
      <column caption='Card Status' datatype='string' name='[Card_Status]' role='dimension' type='nominal' />
